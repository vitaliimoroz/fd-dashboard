{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    // Replaces the base paths: worker code must not import from @app.
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@worker/*": ["./src/worker/*"]
    }
  },
  "include": ["src/worker/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
